# Database
DB_NAME=schultraeger
DB_USER=schultraeger
DB_PASSWORD=schultraeger

# Authentication
# If OIDC_ENABLED=false and no OIDC config is provided, password authentication will be used.
# Users can login with username/password via the /api/auth/login endpoint.
# To create admin users, use the application or seed script (TODO).
OIDC_ENABLED=false
OIDC_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# JWT signing key for password-based authentication (base64-encoded 32-byte key)
# REQUIRED: Generate a unique key for each environment with: openssl rand -base64 32
# SECURITY: Never use the same key across environments or commit real keys to git
JWT_SIGN_KEY=

