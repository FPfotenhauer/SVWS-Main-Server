# Database
DB_NAME=schultraeger
DB_USER=schultraeger
DB_PASSWORD=schultraeger

# Authentication
# If OIDC_ENABLED=false and no OIDC config is provided, password authentication will be used.
# Users can login with username/password via the /api/auth/login endpoint.
# To create admin users, use the application or seed script (TODO).
OIDC_ENABLED=false
OIDC_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# JWT signing key for password-based authentication (base64-encoded 32-byte key)
# REQUIRED: Generate a unique key for each environment with: openssl rand -base64 32
# SECURITY: Never use the same key across environments or commit real keys to git
JWT_SIGN_KEY=

# SVWS Server Integration
# SVWS_PASSWORD_KEY: AES-256 encryption key for storing SVWS server passwords (base64-encoded 32-byte key)
# REQUIRED: Generate a unique key with: openssl rand -base64 32
# SECURITY: Never commit real keys to git
SVWS_PASSWORD_KEY=

# SVWS_TRUST_ALL: Trust self-signed SSL certificates when connecting to SVWS servers
# WARNING: Only use 'true' in development! Production should use proper SSL certificates
# Default: false
SVWS_TRUST_ALL=false

# SVWS_HOST: The host IP or hostname where the SVWS Server is running
# REQUIRED: Set this to your host machine's IP address or hostname
# Example: SVWS_HOST=192.10.11.94 or SVWS_HOST=localhost
# Default: localhost
SVWS_HOST=localhost

# Grafana Infinity datasource auth header (Basic Auth)
# Format: Base64 encoded "username:password"
# Example: echo -n 'svwsuser:svwspass' | base64
SVWS_STAT_BASIC_AUTH_B64=
